{
  "name": "teamify",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start-de": "ng serve --configuration=de",
    "start-en": "ng serve --configuration=en",
    "build": "ng build",
    "build:cloudflare": "ng build --configuration=production,cloudflare",
    "preview": "pnpm run build:cloudflare && wrangler dev",
    "deploy": "pnpm run build:cloudflare && wrangler deploy",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "source-map-analyzer": "ng build --configuration=production --source-map",
    "source-map-explorer": "source-map-explorer dist/teamify/**/*.js",
    "lint": "ng lint"
  },
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "download"
    }
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@ng-bootstrap/ng-bootstrap": "^21.0.0",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/localize": "^22.2.3",
    "@types/jasmine": "~5.1.5",
    "angular-eslint": "22.6.0",
    "eslint": "^9.28.0",
    "happy-dom": "^21.0.3",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.4.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "random-words": "^2.0.1",
    "source-map-explorer": "^2.5.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.33.1",
    "vitest": "^5.0.0",
    "wrangler": "^4.149.0"
  }
}